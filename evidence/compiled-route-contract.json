    "visual_contract": {
      "intent": {
        "design_thesis": "让对象先被看清：用浅色平面、一条强调色和可检查的产品或插画面，把行动放到第一视口。",
        "tone": [
          "明亮",
          "直接",
          "克制",
          "可拿走"
        ],
        "emotional_goal": "让用户立刻理解产品能做什么、如何开始，而不是被气氛、粒子或拟物细节拖住。",
        "differentiation": "扁平来自浅色表面、单一强调色和平面媒体层级，不来自厚拟物按钮、霓虹粒子、玻璃拟态或手绘纹理堆砌。"
      },
      "visual_language": {
        "color": [
          "默认使用纯白画布；浅灰只用于分区，米色/暖白必须由项目明确指定 modifier 才可使用。正文用近黑无衬线，次文用中性灰，对比度必须达标。",
          "全页只选一个强调色，由项目品牌决定；它只出现在主按钮、关键词、选中态、进行中状态或插画可替换层。",
          "章节可用很浅的冷色或纸感洗底，但不得把强调色铺满背景、卡片或全部按钮。"
        ],
        "typography": [
          "营销层优先清晰无衬线；展示体或衬线只用于短标题，且必须已授权。",
          "产品界面内部可使用系统 UI 字体，与营销层字体分开，避免把系统铬当成品牌身份。",
          "字号按断点离散收拢；正文、数字、价格和 CTA 必须横排可读。"
        ],
        "spacing": [
          "首屏和章节使用宽松留白，但每个留白分组必须有标题、对象/证明和下一步。",
          "桌面可用窄内容柱或双列产品面板；窄屏重新计算上下间距，不等比缩小舞台构图。"
        ],
        "layout": [
          "首屏把主张、主行动和可检查媒体放在同一视口；后续用步骤、工作流、能力卡或场景带证明。",
          "导航保持低高度：资源库和消费账户可极简，SaaS 可采用路径导航，但不得把后台壳搬进营销首页。",
          "结尾重复同一主行动，页脚按产品地图或轻量法律链接收束，不做装饰三列。"
        ],
        "shape": [
          "卡片和控件使用中等圆角；主按钮可为胶囊或实心圆角块，次按钮用细描边。",
          "层级优先靠色差、细边框和留白，而不是深阴影或玻璃拟态。",
          "阴影只表达轻微抬起或媒体深度，不得做成拟物厚唇或持续漂浮。"
        ],
        "imagery": [
          "默认媒体必须是可检查的产品界面、信息模块或流程状态；扁平插画只在明确的 illustration-library 任务中使用。",
          "插画变体保持少量阴影、友好人体比例和可替换单强调色；摄影、3D 和手绘纹理不是默认。",
          "缺少真实素材时用已解析的白名单 provider 生成概念媒体并标注 generated-concept，不得冒充可下载资产、客户后台或链上成交。"
        ],
        "iconography": [
          "步骤、能力卡和状态使用少量线性或平面图标，并配可访问名称。",
          "不为装饰引入图标墙，也不复制样本角色、徽章或品牌符号。"
        ],
        "motion": [
          "默认 restrained：短状态过渡、可暂停循环演示、吸顶显现。",
          "逐字显现、跑马灯和入场交错必须提供 reduced-motion 回退；无动效时主行动和证明仍完整。"
        ]
      },
